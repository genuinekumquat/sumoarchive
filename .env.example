# =====================================================
# SUMOARCHIVE Production Environment Variables Template
# 운영 서버 환경변수 설정 시 참고용 템플릿입니다 (.env)
# =====================================================

# 1. 활성 프로필 및 서버 포트
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# 2. Database Connection (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sumo?useSSL=false&characterEncoding=UTF-8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=sumo_prod_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# 3. Application Admin 계정
ADMIN_USERNAME=torikumiAdmin
ADMIN_PASSWORD=your_secure_admin_password
